{
  "schema": "uci_arena_book_forge_config_v1",
  "workspace": "E:/book-forge",
  "policyFile": "policy/strong_rare_v1.policy",
  "stockfish": "../../third_party/bin/stockfish.exe",
  "nativeHelper": "native/build/Release/book_forge_guard.exe",
  "nativeLauncher": "native/build/Release/book_forge_launcher.exe",
  "channels": {
    "integration": true,
    "qualified": true
  },
  "ingestion": {
    "minimumRating": 2000,
    "maximumPly": 30,
    "speeds": ["rapid", "classical"],
    "chunkGames": 25000,
    "maximumChunkRecords": 100000,
    "inboxSettleSeconds": 60
  },
  "analysis": {
    "enabled": true,
    "initialNodes": 250000,
    "confirmationNodes": 2000000,
    "threadsPerWorker": 1,
    "hashMbPerWorker": 128,
    "maximumWorkers": 8,
    "backgroundSipWorkers": 2,
    "backgroundSipEfficiencyCores": 2,
    "backgroundSipDutyCyclePercent": 50
  },
  "acquisition": {
    "enabled": true,
    "provider": "lichess_opening_explorer",
    "endpoint": "https://explorer.lichess.org/lichess",
    "tokenFile": "../../secrets/lichess_bot_token.txt",
    "variant": "standard",
    "speeds": ["rapid", "classical"],
    "ratings": [2000, 2200, 2500],
    "movesPerPosition": 50,
    "maximumPly": 30,
    "minimumGames": 32,
    "crawlLcbGap": 0.1,
    "requestIntervalMs": 5000,
    "dailyRequestBudget": 2000,
    "requestTimeoutMs": 10000,
    "resourcePollMs": 1000,
    "publishedRefreshDays": 7,
    "frontierRefreshDays": 30,
    "firstPublishPositions": 25,
    "firstPublishMaxMinutes": 5,
    "integrationDebounceMinutes": 15
  },
  "pgnAudit": {
    "enabled": false
  },
  "resources": {
    "minimumFreeWorkspaceGb": 75,
    "pauseAvailableMemoryGb": 6,
    "courtesyCpuPercent": 20,
    "idleCpuPercent": 80,
    "priorityProcessNames": ["uci_arena_engine.exe", "msbuild.exe", "cl.exe"]
  },
  "maintenance": {
    "intervalDays": 30,
    "detailedCohortRetentionMonths": 24,
    "snapshotVersionsPerChannel": 4
  },
  "daemon": {
    "cycleIntervalMs": 60000,
    "failureBackoffInitialMs": 5000,
    "failureBackoffMaximumMs": 300000
  }
}
