{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uci_arena_service_output_v1",
  "title": "UCI Arena Book Forge opening-book output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "output_id", "output_kind", "created_at", "state", "authority", "compatibility", "summary", "artifact"],
  "properties": {
    "schema": {"const": "uci_arena_service_output_v1"},
    "output_id": {"type": "string", "pattern": "^(integration|qualified)-[0-9a-f]{20}$"},
    "output_kind": {"const": "opening_book.snapshot"},
    "created_at": {"type": "string"},
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "current", "immutable"],
      "properties": {"channel": {"enum": ["integration", "qualified"]}, "current": {"type": "boolean"}, "immutable": {"const": true}}
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["installable", "strength_qualified", "diagnostic_only", "includes_fixture"],
      "properties": {"installable": {"const": true}, "strength_qualified": {"type": "boolean"}, "diagnostic_only": {"const": false}, "includes_fixture": {"type": "boolean"}}
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "consumer_component_id", "snapshot_schema"],
      "properties": {"component_id": {"const": "opening_book.standard"}, "consumer_component_id": {"const": "uci_arena.engine"}, "snapshot_schema": {"const": "uci_arena_book_snapshot_v2"}}
    },
    "summary": {"type": "object", "additionalProperties": false, "required": ["record_count"], "properties": {"record_count": {"type": "integer", "minimum": 1, "maximum": 2000000}}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "manifest_path", "manifest_sha256", "files"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
